<?xml version="1.0" encoding="utf-8"?>
<!--
  TEMPLATE SEGURO. Antes de usar, substitua todos os valores __EDITAR_ANTES_DE_USAR__
  pela combinação validada para esta ISO (edição, idioma, disco e partições).
  Não use este arquivo sem teste em VM: particionamento e índice da imagem variam por ISO.

  Revisão 2:
  - RunSynchronousCommand do pass windowsPE agora grava status persistente em
    C:\Deploy_copy_status.txt em vez de um "echo" que se perdia.
  - Disparo do Deploy.ps1 movido de FirstLogonCommands (pass oobeSystem) para uma
    tarefa agendada criada no pass specialize (contexto SYSTEM), porque FirstLogonCommands
    pode não executar se a conta local pré-existente na imagem não for administradora
    (comportamento documentado pela Microsoft).
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <SetupUILanguage><UILanguage>pt-BR</UILanguage></SetupUILanguage>
      <InputLocale>pt-BR</InputLocale>
      <SystemLocale>pt-BR</SystemLocale>
      <UILanguage>pt-BR</UILanguage>
      <UserLocale>pt-BR</UserLocale>
    </component>
    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- Inserir aqui DiskConfiguration e ImageInstall específicos da ISO após teste em VM. -->
      <UserData>
        <AcceptEula>true</AcceptEula>
        <FullName>Paschoalotto</FullName>
        <Organization>Paschoalotto</Organization>
      </UserData>
      <RunSynchronous>
        <!-- O destino C: deve existir após a configuração de disco/imagem acima. -->
        <RunSynchronousCommand wcm:action="add" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
          <Order>90</Order>
          <Path>cmd /c if exist X:\Deploy\NUL (mkdir C:\Deploy 2&gt;nul &amp; xcopy X:\Deploy C:\Deploy /e /i /h /y &amp; echo OK %date% %time% &gt; C:\Deploy_copy_status.txt) else (echo ERRO_X_DEPLOY_AUSENTE %date% %time% &gt; C:\Deploy_copy_status.txt)</Path>
          <Description>Copiar payload injetado pelo Ventoy para o disco instalado, com diagnostico persistente</Description>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

  <settings pass="specialize">
    <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
          <Order>1</Order>
          <Path>cmd /c if exist C:\Deploy\Deploy.ps1 (schtasks /create /tn "DeployBootstrap" /tr "powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:\Deploy\Deploy.ps1" /sc onlogon /rl highest /f &gt; C:\Deploy_schtasks_status.txt 2&gt;&amp;1) else (echo ERRO_DEPLOY_PS1_AUSENTE %date% %time% &gt; C:\Deploy_schtasks_status.txt)</Path>
          <Description>Criar tarefa agendada para disparar o Deploy.ps1 no proximo logon, com privilegios elevados</Description>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
      <!-- Não cria nem recria usuários locais: a ISO continua responsável por isso. -->
      <!-- Deploy.ps1 é disparado pela tarefa agendada criada no pass specialize (acima) —
           não há FirstLogonCommands aqui de propósito, para não depender da conta local
           ser administradora. -->
    </component>
  </settings>
</unattend>